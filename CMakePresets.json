{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 16,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "生成 VS工程到 build 目录, 各预设使用独立子目录",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "17",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_C_STANDARD": "11",
        "CMAKE_C_STANDARD_REQUIRED": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "x64 Debug",
      "description": "Debug 配置",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SERVER_DEPLOY_DIR": "${sourceDir}/debug"
      }
    },
    {
      "name": "release",
      "displayName": "x64 Release",
      "description": "Release 配置",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SERVER_DEPLOY_DIR": "${sourceDir}/release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "构建 Debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "displayName": "构建 Release",
      "configurePreset": "release"
    }
  ]
}
